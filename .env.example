# =============================================================================
# HOTEL LE MEDINA & RESTO SINGKAWANG
# Environment Variables Example
#
# Lokal: salin file ini menjadi .env.local.
# Vercel: masukkan variabel melalui Settings > Environment Variables.
#
# PENTING:
# - Jangan memasukkan secret asli ke file ini.
# - Jangan mengunggah .env.local atau file environment rahasia ke GitHub.
# =============================================================================

# 1. SUPABASE DATABASE & AUTHENTICATION
# Ambil URL dan anon key dari Dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret untuk akses database dari server saja.
# Jangan gunakan awalan NEXT_PUBLIC_ pada variabel ini.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-secret

# 2. ADMIN AUTHENTICATION & SESSION SECURITY
# Ganti dengan secret acak yang kuat, minimal 32 karakter.
ADMIN_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Login lokal cadangan hanya untuk development.
# Tetap false kecuali benar-benar diperlukan saat development lokal.
ADMIN_DEV_LOGIN_ENABLED=false

# Kata sandi cadangan development; jangan isi dengan kata sandi produksi.
ADMIN_DEFAULT_PASSWORD=

# 3. WEBSITE INFORMATION
NEXT_PUBLIC_SITE_URL=https://lemedina.id
NEXT_PUBLIC_HOTEL_NAME="Hôtel Le Médina & Resto Singkawang"
NEXT_PUBLIC_HOTEL_WHATSAPP="+628115708899"
NEXT_PUBLIC_HOTEL_PHONE="+62 562 631 888"
NEXT_PUBLIC_HOTEL_EMAIL="info@lemedina.id"

# 4. LOCAL DEVELOPMENT SERVER
# Port lokal yang digunakan proyek.
PORT=5173

# NODE_ENV diatur otomatis oleh Next.js.
# Tidak perlu menentukan NODE_ENV=development di sini.