# 1. Konfigurasi Supabase (Database PostgreSQL & Autentikasi)
# Dapatkan nilai ini dari Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://hlwtvkvcgkyfrtzhkeom.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhsd3R2a3ZjZ2t5ZnJ0emhrZW9tIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI2NTE4MDMsImV4cCI6MjEwODIyNzgwM30.9MoL0M8rIm_SdNdJqT-rpLSAnKT7PDd5_YDxtb-IZds
# Service Role Key HANYA digunakan di server Next.js (Route Handlers), JANGAN sertakan awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 2. Keamanan & Autentikasi Admin (Server-Side Session Hardening)
# Secret key 32+ karakter untuk menandatangani JWT sesi admin (HMAC-SHA256)
ADMIN_SECRET_KEY=ganti-dengan-string-acak-rahasia-panjang-minimal-32-karakter-2026!
# Kata sandi fallback untuk admin panel pada saat inisialisasi / demo
ADMIN_DEFAULT_PASSWORD=MedinaAdmin2026!
# Kunci API opsional untuk integrasi server-ke-server langsung
# ADMIN_API_KEY=lemedina-api-secret-key-production

# 3. Pengaturan Publik & Informasi Operasional Hotel
NEXT_PUBLIC_SITE_URL=https://lemedina.id
NEXT_PUBLIC_HOTEL_NAME="Hôtel Le Médina & Resto Singkawang"
NEXT_PUBLIC_HOTEL_WHATSAPP="+628115708899"
NEXT_PUBLIC_HOTEL_PHONE="+62 562 631 888"
NEXT_PUBLIC_HOTEL_EMAIL="info@lemedina.id"

# 4. Pengaturan Runtime Port (Default 5173)
PORT=5173
NODE_ENV=development
